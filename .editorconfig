# EditorConfig — https://editorconfig.org
# Language formatters (clang-format, cmake-format) own wrapping.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,cc,cxx,cpp,h,hh,hpp,hxx,cu,cuh,mm,m}]
indent_size = 4

[*.{py,pyi}]
indent_size = 4

# Memory's Cmake/*.cmake and CMakeLists.txt use 2-space indent (unlike the
# 4-space XSigma default this file otherwise mirrors) -- see Cmake/*.cmake.
[CMakeLists.txt]
indent_size = 2

[*.{cmake,cmake.in}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.toml]
indent_size = 4

[*.{sh,bash,zsh}]
indent_size = 2

[*.{md,mdx,markdown}]
trim_trailing_whitespace = false
indent_size = unset

[{Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab
