[codespell]
ignore-words = Scripts/suppressions/spell_suppressions.txt
skip = .git,.augment,.github,.vscode,build,Build,build_*,build-*,.venv*,venv*,bazel-*,ThirdParty,third_party,3rdparty,*ThirdParty*,*third_party*,*3rdparty*,.mypy_cache,__pycache__,.pytest_cache,.ruff_cache,*.mypy_cache*,*__pycache__*,*.pytest_cache*,*.ruff_cache*,*.pb.*,*.lock
check-hidden = no
