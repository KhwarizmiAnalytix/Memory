# Build directories
build/
build_*/
build-*/
out/
cmake-build-*/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
DartConfiguration.tcl

# Bazel
bazel-*
# //ThirdParty/Logging's vendor_deps.bzl module extension resolves
# ThirdParty/{fmt,loguru,spdlog,googletest,benchmark} via local_repository
# using each checkout's absolute path. Bazel's module-extension lock caching
# does not re-run the extension when its declared inputs are unchanged, so a
# committed MODULE.bazel.lock replays the absolute path from whichever
# machine last regenerated it — breaking the build on every other
# machine/CI runner. Never commit it; let each environment regenerate its own.
MODULE.bazel.lock

