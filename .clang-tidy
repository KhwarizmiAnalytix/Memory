---
# Preserve established parameter ordering and deliberate numeric conversions.
# Headers intentionally use #pragma once rather than include guards.
Checks: >
  -*,
  bugprone-*,
  performance-*,
  portability-*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-equals-default,
  readability-braces-around-statements,
  modernize-use-equals-delete,
  readability-redundant-*,
  readability-container-size-empty,
  -bugprone-easily-swappable-parameters,
  -portability-avoid-pragma-once
WarningsAsErrors: '*'
HeaderFilterRegex: '(^|.*/)(include|src|Testing|Tests|examples|Examples)/'
FormatStyle: file
CheckOptions:
  bugprone-reserved-identifier.AllowedIdentifiers: '^__TBB_NO_IMPLICIT_LINKAGE$'
