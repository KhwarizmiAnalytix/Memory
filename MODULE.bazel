module(
    name = "xsigma_memory",
    version = "1.0.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "rules_pkg", version = "1.0.1")

# Logging library (vendored git submodule), wired as its own Bazel module
# rather than a custom staging repo rule — matches LinearAlgebra/Solvers.
# fmt is resolved transitively through Logging's own MODULE.bazel; the
# backend is selected via --define=logging_backend=native (see .bazelrc)
# instead of overriding Logging's own bazel/logging.bzl defaults.
bazel_dep(name = "xsigma_logging", version = "1.0.0")
bazel_dep(name = "magic_enum", version = "0.9.8")

local_path_override(
    module_name = "xsigma_logging",
    path = "ThirdParty/Logging",
)

local_path_override(
    module_name = "magic_enum",
    path = "ThirdParty/Logging/ThirdParty/magic_enum",
)

# Resolve vendor paths relative to this workspace.
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")
local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "local_repository")

# CUDA Toolkit — discover CUDA_PATH/CUDA_HOME, nvcc on PATH, or the
# conventional Linux/Windows install location.
cuda_repository = use_repo_rule("//bazel:cuda_repository.bzl", "cuda_repository")

cuda_repository(name = "local_config_cuda")

# HIP/ROCm — @local_config_hip wraps a system-installed ROCm SDK on Unix, or
# fails analysis with a clear message (Windows, or no SDK found) the moment
# --define=memory_gpu_backend=hip is actually selected. Mirrors
# Cmake/hip.cmake's WIN32 guard and "HIP not found" FATAL_ERROR.
hip_repository = use_repo_rule("//bazel:hip_repository.bzl", "hip_repository")

hip_repository(name = "local_config_hip")

# TBB — system-installed oneTBB, found via TBB_ROOT / TBB_DIR / TBBROOT.
# Mirrors cmake/tbb_memory.cmake's find_package(TBB) pattern: no vendored
# ThirdParty/tbb submodule. Required when --define=memory_enable_tbb=true.
tbb_repository = use_repo_rule("//bazel:tbb_repository.bzl", "tbb_repository")

tbb_repository(name = "tbb")

# mimalloc — vendored nested submodule (ThirdParty/)
new_local_repository(
    name = "mimalloc",
    path = "ThirdParty/mimalloc",
    build_file = "//bazel:mimalloc.BUILD",
)

# Google Test / Benchmark — vendored nested submodules (ThirdParty/)
local_repository(
    name = "com_google_googletest",
    path = "ThirdParty/googletest",
)

local_repository(
    name = "com_google_benchmark",
    path = "ThirdParty/benchmark",
)
