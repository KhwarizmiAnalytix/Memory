# Pure Bzlmod (no WORKSPACE.bazel) — matches LinearAlgebra/Solvers. All
# ThirdParty/ submodules are wired via MODULE.bazel (bazel_dep +
# local_path_override / use_repo_rule), so Bazel 9's removal of
# WORKSPACE-based repos doesn't affect this repo.

# Auto-select the build:<os>/test:<os> blocks below for the host platform
# (linux/macos/windows), so cross-platform flags don't need --config.
common --enable_platform_specific_config

# This workspace has no Android targets; don't attempt to autoload an
# undeclared rules_android module during Bazel's external-rule discovery.
common --incompatible_autoload_externally=-@rules_android

# Bazel 8 gates its transitive archive rule behind this flag. The standalone
# package uses it to include Memory's compiled Logging/mimalloc dependencies.
build --experimental_cc_static_library

# C++20 by default (mirrors MEMORY_CXX_STANDARD=20 in CMakeLists.txt).
# The command line may override this default with --cxxopt/--host_cxxopt.
# Target copts deliberately do not repeat the language standard.
build:linux --cxxopt=-std=c++20 --host_cxxopt=-std=c++20
build:macos --cxxopt=-std=c++20 --host_cxxopt=-std=c++20
build:windows --cxxopt=/std:c++20 --host_cxxopt=/std:c++20

# GPU backend selector example:
#   bazel build //... --define=memory_gpu_backend=cuda
#   bazel build //... --define=memory_enable_tbb=true

# Logging backend — this repo forces NATIVE instead of Logging's own default
# (LOGURU), via the standard flag Logging's own bazel/BUILD.bazel exposes.
# Other options: glog, spdlog, loguru.
build --define=logging_backend=native

# Profiler is an optional installed dependency. Set PROFILER_ROOT to its install
# prefix before enabling --define=memory_enable_profiler=true.
build --define=memory_enable_profiler=false
