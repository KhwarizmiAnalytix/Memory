# Keep WORKSPACE mode working alongside Bzlmod (same approach as XSigma).
# Requires Bazel 7/8 — WORKSPACE-based repos (local_repository / new_local_repository
# in WORKSPACE.bazel, wiring every ThirdParty/ submodule) are unsupported starting
# with Bazel 9. See .bazelversion; bump only after migrating WORKSPACE.bazel to
# bzlmod (MODULE.bazel) equivalents (e.g. local_path_override / a repo rule).
build --enable_workspace

# Auto-select the build:<os>/test:<os> blocks below for the host platform
# (linux/macos/windows), so cross-platform flags don't need --config.
common --enable_platform_specific_config

# C++20 by default (mirrors MEMORY_CXX_STANDARD=20 in CMakeLists.txt).
# MSVC takes /std:c++20, not -std=c++20 — unlike memory_copts()/xsigma_copts()
# (bazel/xsigma.bzl), which already select() this per target, this applies to
# every target including third-party deps, so it must be split per OS too.
build:linux --cxxopt=-std=c++20 --host_cxxopt=-std=c++20
build:macos --cxxopt=-std=c++20 --host_cxxopt=-std=c++20
build:windows --cxxopt=/std:c++20 --host_cxxopt=/std:c++20

# Local distdir for WORKSPACE http_archive dependencies — avoids fetching over
# TLS when Java's bundled cert store can't validate the remote (PKIX error on
# Windows). Archives here must match the sha256 declared in WORKSPACE.bazel.
# Add new archives with: Invoke-WebRequest <url> -OutFile bazel\distdir\<file>
build --distdir=bazel/distdir

# GPU backend selector example:
#   bazel build //... --define=memory_gpu_backend=cuda
#   bazel build //... --define=memory_enable_tbb=true

# Profiler is off by default under Bazel: ThirdParty/profiler.BUILD still targets
# Profiler's pre-include/ source layout and does not yet wire its kineto/ittapi
# dependencies, so @profiler//:Profiler does not build. CMake keeps
# MEMORY_ENABLE_PROFILER=ON. Re-enable with --define=memory_enable_profiler=true
# once the overlay is ported.
build --define=memory_enable_profiler=false
